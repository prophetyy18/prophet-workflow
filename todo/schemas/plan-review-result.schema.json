{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prophet-workflow.local/schemas/plan-review-result.schema.json",
  "title": "Plan-reviewer structured result",
  "type": "object",
  "required": [
    "task_id",
    "base_commit",
    "candidate_commit",
    "verdict",
    "summary"
  ],
  "additionalProperties": true,
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "summary": {"type": "string"}
  }
}
