{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prophet-workflow.local/schemas/triage-result.schema.json",
  "title": "Issue-triager structured result",
  "type": "object",
  "required": [
    "task_id",
    "classification",
    "summary",
    "evidence",
    "recommended_action"
  ],
  "additionalProperties": true,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(T[0-9]{3}|M[0-9]{4})$"
    },
    "classification": {
      "type": "string",
      "enum": [
        "IMPLEMENTATION_DEFECT",
        "CONTRACT_MISMATCH",
        "SPEC_DEFECT",
        "OWNER_DECISION_REQUIRED",
        "EXTERNAL_BLOCKED"
      ]
    },
    "summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "recommended_action": {"type": "string"},
    "decision_question": {"type": "string"}
  }
}
