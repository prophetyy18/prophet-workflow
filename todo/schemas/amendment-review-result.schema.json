{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prophet-workflow.local/schemas/amendment-review-result.schema.json",
  "title": "Plan-reviewer / Prophet-reviewer structured result",
  "type": "object",
  "required": [
    "amendment_id",
    "base_commit",
    "candidate_commit",
    "verdict",
    "summary",
    "required_changes",
    "unknowns"
  ],
  "additionalProperties": true,
  "properties": {
    "amendment_id": {
      "type": "string",
      "pattern": "^A[0-9]{4}$"
    },
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "verdict": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
    "summary": {"type": "string"},
    "required_changes": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  }
}
