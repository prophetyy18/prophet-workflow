{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prophet-workflow.local/schemas/planner-result.schema.json",
  "title": "Planner structured result (triaged issue route)",
  "type": "object",
  "required": [
    "task_id",
    "classification",
    "base_commit",
    "candidate_commit"
  ],
  "additionalProperties": true,
  "properties": {
    "task_id": {"type": "string", "pattern": "^T[0-9]{3}$"},
    "classification": {
      "type": "string",
      "enum": [
        "IMPLEMENTATION_DEFECT",
        "CONTRACT_MISMATCH",
        "SPEC_DEFECT",
        "OWNER_DECISION_REQUIRED",
        "EXTERNAL_BLOCKED"
      ]
    },
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
