{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://prophet-workflow.local/schemas/developer-result.schema.json",
  "title": "Stage-developer structured result",
  "type": "object",
  "required": ["task_id", "outcome", "summary", "commands", "residual_risks"],
  "additionalProperties": true,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(T[0-9]{3}|M[0-9]{4})$"
    },
    "outcome": {
      "type": "string",
      "enum": ["CANDIDATE_READY", "CONTINUATION_REQUIRED", "TRIAGE_REQUIRED", "BLOCKED"]
    },
    "summary": {"type": "string", "minLength": 1},
    "blocking_question": {"type": "string"},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "result"],
        "properties": {
          "command": {"type": "string"},
          "result": {"type": "string"}
        }
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "triage_request": {
      "type": "object",
      "required": [
        "observed_problem",
        "evidence",
        "proposed_classification",
        "requested_change"
      ],
      "properties": {
        "observed_problem": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "proposed_classification": {
          "type": "string",
          "enum": [
            "IMPLEMENTATION_DEFECT",
            "CONTRACT_MISMATCH",
            "SPEC_DEFECT",
            "OWNER_DECISION_REQUIRED",
            "EXTERNAL_BLOCKED"
          ]
        },
        "requested_change": {"type": "string"}
      }
    },
    "continuation": {
      "type": "object",
      "required": [
        "reason",
        "completed_work",
        "remaining_work",
        "next_actions",
        "changed_paths"
      ],
      "properties": {
        "reason": {"type": "string", "const": "TURN_BUDGET"},
        "completed_work": {"type": "array", "items": {"type": "string"}},
        "remaining_work": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "next_actions": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "changed_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
